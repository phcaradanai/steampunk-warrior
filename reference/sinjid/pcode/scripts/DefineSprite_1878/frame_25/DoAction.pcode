GetMember
Push 5
Add2
Push 0.0, 0.0, false, "_root"
GetVariable
Push "mcname"
GetVariable
Push "magdmg"
Add2
GetMember
Push 40
Add2
Push 9, "_root"
GetVariable
Push "skill"
GetMember
Push 4
GetMember
