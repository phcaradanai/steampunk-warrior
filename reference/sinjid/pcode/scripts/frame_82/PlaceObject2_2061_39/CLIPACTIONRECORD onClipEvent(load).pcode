ConstantPool "attacks", "attack", "numofmoves", "mcname2", "enemy1", "subject2", "dmgtype2", "enemy"
Push "attacks", "attack", 1
InitArray
SetVariable
Push "numofmoves", 1
SetVariable
Push "mcname2", "enemy1"
SetVariable
Push "subject2", "enemy1"
SetVariable
Push "dmgtype2", "enemy"
SetVariable
