ConstantPool "attacks", "attack", "numofmoves", "mcname2", "enemy2", "subject2", "dmgtype2", "enemy", "this", "_visible"
Push "attacks", "attack", 1
InitArray
SetVariable
Push "numofmoves", 1
SetVariable
Push "mcname2", "enemy2"
SetVariable
Push "subject2", "enemy2"
SetVariable
Push "dmgtype2", "enemy"
SetVariable
Push "this"
GetVariable
Push "_visible", false
SetMember
