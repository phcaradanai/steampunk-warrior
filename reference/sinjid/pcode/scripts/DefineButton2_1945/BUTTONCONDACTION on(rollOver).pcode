ConstantPool "skilllabel", "_root", "Skill", "manareq", "manacostv", "Mana Cost: ", "manacostv2"
Push "skilllabel", 5
SetVariable
Push "_root"
GetVariable
Push "Skill"
GetMember
Push "skilllabel"
GetVariable
GetMember
Push 0.0
Greater
Not
If loc009e
Push "manareq", 25
SetVariable
Push "_root"
GetVariable
Push "manacostv", "Mana Cost: "
SetMember
Push "_root"
GetVariable
Push "manacostv2", "manareq"
GetVariable
SetMember
loc009e: