GetVariable
Push "_root"
GetVariable
Push "enemytarget"
GetMember
Push "life"
Add2
GetMember
SetVariable
Push 0.0, "_root"
GetVariable
Push "mcname"
GetVariable
Push "speed"
Add2
GetMember
Push 0.0, 999, false, 0.0, "dmg"
GetVariable
