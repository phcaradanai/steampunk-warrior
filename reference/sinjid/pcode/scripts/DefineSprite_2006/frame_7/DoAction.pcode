ConstantPool "_root", "subject", "shieldtype", "shield", "gotoAndStop", "None"
Push "_root"
GetVariable
Push "subject"
GetVariable
Push "shieldtype"
Add2
GetMember
Push 1, "shield"
GetVariable
Push "gotoAndStop"
CallMethod
Pop
Push "_root"
