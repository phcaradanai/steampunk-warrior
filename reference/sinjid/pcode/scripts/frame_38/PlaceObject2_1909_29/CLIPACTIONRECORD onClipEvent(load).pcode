ConstantPool "attacks", "Skille2", "attack", "numofmoves", "length", "mcname2", "enemy2", "subject2", "dmgtype2", "enemy"
Push "attacks", "Skille2", "attack", 2
InitArray
SetVariable
Push "numofmoves", "attacks"
GetVariable
Push "length"
GetMember
SetVariable
Push "mcname2", "enemy2"
SetVariable
Push "subject2", "enemy2"
SetVariable
Push "dmgtype2", "enemy"
SetVariable
