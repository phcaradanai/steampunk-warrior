ConstantPool "skilllabel", "_root", "Skill", "manareq", "manacostv", "Mana Cost: ", "manacostv2"
Push "skilllabel", 0.0
SetVariable
Push "_root"
GetVariable
Push "Skill"
GetMember
Push "skilllabel"
GetVariable
GetMember
Push 0.0
Greater
Not
If loc00a2
Push "manareq", 15
SetVariable
Push "_root"
GetVariable
Push "manacostv", "Mana Cost: "
SetMember
Push "_root"
GetVariable
Push "manacostv2", "manareq"
GetVariable
SetMember
loc00a2: