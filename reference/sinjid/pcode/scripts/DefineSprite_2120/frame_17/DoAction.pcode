ConstantPool "stand", "_root", "mcname", "gotoAndStop", "subject", "shieldtype", "None"
Push "stand", 1, "_root"
GetVariable
Push "mcname"
GetVariable
GetMember
Push "gotoAndStop"
CallMethod
Pop
Push "_root"
GetVariable
Push "subject"
GetVariable
Push "shieldtype"
Add2
Push "None"
SetMember
